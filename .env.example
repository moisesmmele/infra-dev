# Docker Network
NETWORK_NAME=dev-net
NETWORK_SUBNET=172.16.20.0/24

# Portainer
PORTAINER_PORT=9000

# CloudBeaver
CLOUDBEAVER_PORT=8978

# Redis Insight 
REDIS_INSIGHT_PORT=5540

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Hoppscotch
# Mapped to 3100 to avoid conflict with Homepage
HOPPSCOTCH_PORT=3100

# Nginx Proxy Manager
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# Technitium DNS
DNS_UDP_PORT=53
DNS_TCP_PORT=53
DNS_WEB_PORT=5380

# Homepage
HOMEPAGE_PORT=3000
